# Pooled runtime URL (PrismaClient). Hostname MUST include `-pooler`.
# Neon Console → Connect → "Pooled connection". Required on Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/riyadh_prints?sslmode=require"

# Unpooled URL (migrations, db push, Studio). Hostname has NO `-pooler`.
# Neon Console → Connect → "Direct connection".
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/riyadh_prints?sslmode=require"

# Seed (required, non-empty). `npm run db:seed` and `db:reset` fail if unset.
SEED_ADMIN_EMAIL="admin@riyadhprints.com"
SEED_ADMIN_PASSWORD=""
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
BLOB_READ_WRITE_TOKEN=""
NEXT_PUBLIC_GA_ID=""
RESEND_API_KEY=""
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Optional WooCommerce REST keys. If unset, products are taken from
# /wp/v2/product and scraped from the sitemap.
WC_CONSUMER_KEY=""
WC_CONSUMER_SECRET=""
